{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // CAD capability: DXF parsing + object detection in-Worker, DWG conversion and
  // approved write-back through Autodesk Platform Services Design Automation
  // (AutoCAD engine). Consumed over a Service Binding as CadService.
  "name": "jacsal-sync-cad",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "upload_source_maps": true,
  // Headless browser parked on the Autodesk origin: Worker subrequests to developer.api.autodesk.com get HTTP 525.
  "browser": { "binding": "BROWSER" },
  // Same bucket as the app: DWG inputs are read from here and Design Automation outputs are streamed
  // straight into it, so no drawing ever crosses the 32 MiB service-binding RPC limit.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "jacsal-sync-files" }],
  // Parsing a 100 MB+ DXF is CPU-bound; lift the default 30 s budget.
  "limits": { "cpu_ms": 300000 },
  "secrets_store_secrets": [
    { "binding": "APS_CLIENT_ID",     "store_id": "393ef1d6ad114ec598b1b2abf1e9a2b6", "secret_name": "APS_CLIENT_ID" },
    { "binding": "APS_CLIENT_SECRET", "store_id": "393ef1d6ad114ec598b1b2abf1e9a2b6", "secret_name": "APS_CLIENT_SECRET" },
    { "binding": "APS_RELAY_KEY",     "store_id": "393ef1d6ad114ec598b1b2abf1e9a2b6", "secret_name": "APS_RELAY_KEY" }
  ],
  "vars": {
    "APS_ENGINE": "Autodesk.AutoCAD+25_1",
    "APS_ACTIVITY": "RunScript",
    "APS_ALIAS": "prod",
    "APS_REGION": "US",
    // Relay outside Cloudflare for developer.api.autodesk.com (see relay/README.md). Empty = direct.
    "APS_RELAY_URL": "",
    // "true" = make Autodesk API calls from a Browser Rendering session instead of the default TLS-socket HTTP client.
    "APS_VIA_BROWSER": "false"
  }
}
